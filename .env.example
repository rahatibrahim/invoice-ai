# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Never commit .env. Never put real keys in this file.

# ── Extraction (provider and model are decided after the feasibility spike) ──
LLM_PROVIDER=your-provider        # e.g. the name of the chosen LLM API provider
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name

# OCR (only needed for the OCR + LLM approach)
OCR_PROVIDER=
OCR_API_KEY=

# ── Input limits (see docs/01-requirements.md §4) ──
MAX_FILE_SIZE_MB=10
MAX_PAGES=5

# ── Evaluation ──
EVAL_COST_LIMIT_JPY=500           # stop an evaluation run if its API cost exceeds this

# ── Logging ──
LOG_LEVEL=INFO
